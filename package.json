{
  "name": "legacy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://legacyhubgh.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-page-metadata.mjs",
    "check:worker": "tsc -p tsconfig.worker.json",
    "test:bookings": "node --test scripts/test-booking-email.cjs",
    "dev:worker": "wrangler dev",
    "deploy:cloudflare": "npm run build && npm run check:worker && wrangler deploy",
    "optimize:images": "node scripts/generate-responsive-images.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "clsx": "^2.1.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "lucide-react": "^1.16.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.166.0"
  }
}
